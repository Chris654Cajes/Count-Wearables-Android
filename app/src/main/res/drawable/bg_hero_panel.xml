<?xml version="1.0" encoding="utf-8"?>
<!-- Layered gold-glow HUD panel: outer soft glow ring + inner gilded panel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_glow" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <stroke android:width="1.5dp" android:color="@color/primary" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
