<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Arcane Vault — RPG Inventory Theme -->
    <style name="Theme.CountWearables" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/secondary</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Status & Navigation Bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Fonts: bold, slightly spaced caps everywhere for a "game HUD" feel -->
        <item name="android:fontFamily">sans-serif-condensed</item>

        <!-- Dialog & Alert Styles -->
        <item name="alertDialogTheme">@style/Theme.CountWearables.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.CountWearables.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.CountWearables.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.CountWearables.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.CountWearables.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.CountWearables.CardView</item>
        <item name="toolbarStyle">@style/Widget.CountWearables.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.CountWearables.BottomNav</item>
        <item name="chipStyle">@style/Widget.CountWearables.Chip</item>
    </style>

    <!-- Dialog Style -->
    <style name="Theme.CountWearables.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_panel</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CountWearables.MediumComponent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CountWearables.Button.Outlined</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CountWearables.Button.Outlined</item>
    </style>

    <style name="ShapeAppearance.CountWearables.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ============ HUD TEXT STYLES ============ -->
    <style name="TextAppearance.CountWearables.ScreenTitle" parent="android:TextAppearance.Material">
        <item name="android:textColor">@color/text_gold_accent</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TextAppearance.CountWearables.SectionHeader" parent="android:TextAppearance.Material">
        <item name="android:textColor">@color/secondary_light</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="TextAppearance.CountWearables.StatValue" parent="android:TextAppearance.Material">
        <item name="android:textColor">@color/text_gold_accent</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CountWearables.StatLabel" parent="android:TextAppearance.Material">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- ============ BUTTON STYLES ============ -->
    <style name="Widget.CountWearables.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">6dp</item>
    </style>

    <style name="Widget.CountWearables.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/secondary_light</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/secondary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.CountWearables.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ============ TEXT INPUT ============ -->
    <style name="Widget.CountWearables.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/surface_variant</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- ============ CARD / PANEL ============ -->
    <style name="Widget.CountWearables.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="Widget.CountWearables.CardView.Gilded">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- ============ TOOLBAR / NAV ============ -->
    <style name="Widget.CountWearables.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/text_gold_accent</item>
        <item name="navigationIconTint">@color/primary</item>
    </style>

    <style name="Widget.CountWearables.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemIconTint">@color/primary</item>
        <item name="itemTextColor">@color/text_secondary</item>
        <item name="elevation">12dp</item>
    </style>

    <style name="Widget.CountWearables.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
